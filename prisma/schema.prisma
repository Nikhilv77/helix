generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum DesignSessionStatus {
  DRAFT
  REQUIREMENTS_PENDING
  READY_FOR_DESIGN
  GENERATING
  COMPLETED
  FAILED
}

enum KnowledgeSourceType {
  PLAIN_TEXT
  MARKDOWN
}

enum KnowledgeDocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum KnowledgeEmbeddingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RoadmapTemplateStatus {
  ACTIVE
  ARCHIVED
}

enum UserRoadmapStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum RoadmapProgressStatus {
  LOCKED
  ACTIVE
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum PracticeSessionAvailability {
  AVAILABLE
  UNAVAILABLE
}

enum PrepQuestionPublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RoadmapQuestionSourceType {
  DSA
  PREP
  CUSTOM
}

enum RoadmapQuestionAttemptStatus {
  STARTED
  SUBMITTED
  COMPLETED
  SKIPPED
}

/// Whether an attempt is safe to consume as demonstrated ability.
/// NOT_APPLICABLE covers navigation actions such as skip; UNVERIFIED preserves
/// learner work when an evaluator is unavailable without treating it as proof.
enum PracticeAttemptVerificationStatus {
  VERIFIED
  UNVERIFIED
  NOT_APPLICABLE
}

enum MayaInsightKind {
  NEXT_PRIORITY
  COMMON_TRAP
  STRONG_SIGNAL
  STREAK
  RECOMMENDED_ACTION
}

enum PersonalizedInterviewPlanStatus {
  DRAFT
  READY
  SUPERSEDED
}

enum PersonalizedInterviewSessionKind {
  PROBLEM_SOLVING
  CORE_TECHNICAL
  APPLIED_ENGINEERING
  ARCHITECTURE_SYSTEM_DESIGN
  FINAL_MOCK
}

model Project {
  id             String          @id @default(uuid()) @db.Uuid
  ownerId        String          @default("local-dev")
  name           String
  description    String?
  status         ProjectStatus   @default(ACTIVE)
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  designSessions DesignSession[]

  @@index([ownerId])
  @@index([status])
  @@index([name])
  @@index([createdAt])
}

model DesignSession {
  id                     String              @id @default(uuid()) @db.Uuid
  projectId              String              @db.Uuid
  title                  String
  problemStatement       String
  status                 DesignSessionStatus @default(DRAFT)
  currentStep            String?
  failureCode            String?
  failureMessage         String?
  requirementAnalysis    Json?
  clarificationAnswers   Json?
  requirementsAnalyzedAt DateTime?
  capacityCalculation    Json?
  capacityCalculatedAt   DateTime?
  generatedDesign        Json?
  designGeneratedAt      DateTime?
  architectureDiagram    Json?
  diagramGeneratedAt     DateTime?
  designValidation       Json?
  designValidatedAt      DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  project                Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([projectId, createdAt])
}

model KnowledgeDocument {
  id                    String                   @id @default(uuid()) @db.Uuid
  title                 String
  sourceType            KnowledgeSourceType
  sourceUrl             String?
  contentHash           String                   @unique
  status                KnowledgeDocumentStatus  @default(PENDING)
  errorMessage          String?
  embeddingStatus       KnowledgeEmbeddingStatus @default(PENDING)
  embeddingErrorMessage String?
  embeddedAt            DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  chunks                KnowledgeChunk[]

  @@index([status])
  @@index([embeddingStatus])
  @@index([sourceType])
  @@index([createdAt])
}

model KnowledgeChunk {
  id                    String                   @id @default(uuid()) @db.Uuid
  documentId            String                   @db.Uuid
  content               String
  contentHash           String?
  chunkIndex            Int
  tokenEstimate         Int
  metadata              Json
  embedding             Unsupported("vector")?
  embeddingStatus       KnowledgeEmbeddingStatus @default(PENDING)
  embeddingModel        String?
  embeddingModelVersion String?
  embeddingContentHash  String?
  embeddingErrorMessage String?
  embeddedAt            DateTime?
  createdAt             DateTime                 @default(now())
  document              KnowledgeDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([contentHash])
  @@index([embeddingStatus])
  @@index([embeddingModel, embeddingModelVersion])
  @@index([chunkIndex])
}

model InterviewSession {
  id             String                   @id @db.Uuid
  ownerId        String
  state          Json
  version        Int                      @default(0)
  startedAt      DateTime
  touchedAt      DateTime                 @updatedAt
  createdAt      DateTime                 @default(now())
  answerRequests InterviewAnswerRequest[]

  @@index([ownerId, startedAt])
  @@index([touchedAt])
}

model InterviewAnswerRequest {
  id         String           @id @default(uuid()) @db.Uuid
  sessionId  String           @db.Uuid
  turnId     String           @db.Uuid
  answerHash String
  status     String
  response   Json?
  leaseUntil DateTime
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  session    InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, turnId])
  @@index([status, leaseUntil])
}

model CandidateProfile {
  ownerId                     String                               @id
  targetRole                  String?
  level                       String?
  targetCompany               String?
  targetDate                  DateTime?
  headline                    String?
  context                     String?
  coverImage                  String?
  profileImage                String?
  workspaceAccent             String                               @default("ember")
  /// Preferred language for standalone DSA practice editor sessions.
  dsaEditorLanguage           String                               @default("javascript")
  /// Persona id from src/lib/avatars/personas.ts — the teacher chosen at onboarding.
  teacherId                   String?
  /// False stops this candidate being asked to help with other people's questions.
  helpNotificationsEnabled    Boolean                              @default(true)
  /// False pauses the teacher's optional daily practice recommendations.
  teacherNotificationsEnabled Boolean                              @default(true)
  focusAreas                  Json
  stories                     Json
  resumeFileName              String?
  resumeMimeType              String?
  resumeAnalysis              Json?
  resumeUploadedAt            DateTime?
  resumeVerifiedAt            DateTime?
  resumeConfidence            Float?
  onboardingCompletedAt       DateTime?
  /// Maya's curated session plan for this candidate, generated from the resume.
  curriculum                  Json?
  curriculumBuiltAt           DateTime?
  createdAt                   DateTime                             @default(now())
  updatedAt                   DateTime                             @updatedAt
  roadmaps                    UserRoadmap[]
  questionAttempts            UserQuestionAttempt[]
  mayaInsights                UserMayaInsight[]
  dsaNotes                    UserDsaQuestionNote[]
  prepNotes                   UserPrepQuestionNote[]
  interviewProfileVersions    CandidateInterviewProfileVersion[]   @relation("CandidateInterviewProfileVersions")
  interviewPlanVersions       PersonalizedInterviewPlanVersion[]   @relation("CandidateInterviewPlanVersions")
  performanceProfileVersions  CandidatePerformanceProfileVersion[] @relation("CandidatePerformanceProfileVersions")
  practiceEvidenceVersions    CandidatePracticeEvidenceVersion[]   @relation("CandidatePracticeEvidenceVersions")
  helpRequests                HelpRequest[]                        @relation("HelpRequestsAsked")
  helpRequestDeclines         HelpRequestDecline[]                 @relation("HelpRequestsDeclined")
  notifications               Notification[]                       @relation("CandidateNotifications")

  @@index([updatedAt])
}

/// Immutable aggregate of demonstrated skill evidence from completed
/// personalized interview sessions.
/// Status of a contextual peer-help request.
///
/// OPEN and CLAIMED are the only live states; the other three are terminal.
/// A request in a terminal state is history and is never transitioned again.
enum HelpRequestStatus {
  OPEN
  CLAIMED
  RESOLVED
  EXPIRED
  CANCELLED
}

/// A learner asking for human help on a practice problem they are stuck on.
///
/// The request carries its own snapshot of the workspace rather than pointing
/// at live state: a helper who accepts twenty minutes later needs to see where
/// the learner was *when they asked*, and the learner keeps editing meanwhile.
model HelpRequest {
  id           String               @id @default(uuid()) @db.Uuid
  learnerId    String
  questionSlug String
  /// Programming language of the attempt, used to match a helper who knows it.
  language     String
  status       HelpRequestStatus    @default(OPEN)
  /// Workspace snapshot taken at the moment of asking — see HelpRequestContext.
  context      Json
  /// Maya's summary of where the learner appears to be stuck. Null until the
  /// summary job fills it in, so the request is never blocked on the model.
  summary      String?              @db.Text
  helperId     String?
  claimedAt    DateTime?
  resolvedAt   DateTime?
  /// Set when the learner withdraws or a sweep retires an unanswered request.
  closedAt     DateTime?
  /// After this, a sweep moves an unclaimed request to EXPIRED.
  expiresAt    DateTime
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  learner      CandidateProfile     @relation("HelpRequestsAsked", fields: [learnerId], references: [ownerId], onDelete: Cascade)
  question     DsaQuestion          @relation(fields: [questionSlug], references: [slug], onDelete: Cascade)
  session      HelpSession?
  declines     HelpRequestDecline[]

  @@index([status, expiresAt])
  @@index([questionSlug, status])
  @@index([learnerId, createdAt])
  @@index([helperId])
}

/// A helper passing on one request without changing it for anybody else.
/// Persistent so the same request does not return on refresh or another device.
model HelpRequestDecline {
  id        String           @id @default(uuid()) @db.Uuid
  requestId String           @db.Uuid
  helperId  String
  createdAt DateTime         @default(now())
  request   HelpRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  helper    CandidateProfile @relation("HelpRequestsDeclined", fields: [helperId], references: [ownerId], onDelete: Cascade)

  @@unique([requestId, helperId])
  @@index([helperId, createdAt])
}

/// The live call for a claimed request. Created when either participant asks to
/// join, not when the helper accepts — accepting is a promise, joining starts it.
model HelpSession {
  id                     String      @id @default(uuid()) @db.Uuid
  requestId              String      @unique @db.Uuid
  /// LiveKit room. Unique so a retry cannot open a second room for one request.
  roomName               String      @unique
  startedAt              DateTime    @default(now())
  /// First successful token authorization for each seat. Both are required
  /// before the conversation is eligible for learner feedback.
  learnerJoinedAt        DateTime?
  helperJoinedAt         DateTime?
  endedAt                DateTime?
  /// Why the call ended: "resolved", "left", "timeout", "reported".
  endedReason            String?
  /// 1-5, collected after the call. Null while the session is live or skipped.
  learnerRating          Int?
  /// Persisted so "Skip" remains skipped after a reload or another device.
  learnerRatingSkippedAt DateTime?
  /// Yjs document containing the shared notes and completed drawing strokes.
  collaborationState     Bytes?
  collaborationUpdatedAt DateTime?
  /// Small capped recognition when a helper waited but the learner never joined.
  helperWaitCreditAt     DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  request                HelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([startedAt])
}

/// What a notification is about. The value is stable and stored, so renaming a
/// member is a migration, not a refactor.
enum NotificationKind {
  /// One-time message from the selected teacher after onboarding completes.
  TEACHER_WELCOME
  /// Daily question or practice-path recommendation from the selected teacher.
  TEACHER_RECOMMENDATION
  /// An occasional warm note or motivational thought from the selected teacher.
  TEACHER_ENCOURAGEMENT
  /// A second, evidence-backed nudge for unfinished work; never sent by default.
  TEACHER_REMINDER
  /// Someone is stuck on a question you have already finished.
  HELP_REQUEST_OPENED
  /// A helper accepted the request you opened.
  HELP_REQUEST_CLAIMED
  /// Your request was answered and closed.
  HELP_REQUEST_RESOLVED
  /// Nobody picked your request up before it timed out.
  HELP_REQUEST_EXPIRED
  /// The learner explicitly thanked their helper after a completed conversation.
  HELP_FEEDBACK_RECEIVED
}

/// One item in a candidate's inbox.
///
/// Deliberately generic: help requests are the first thing to use it, but the
/// shape carries no help-specific field so the next feature that needs to reach
/// somebody does not get its own parallel table.
model Notification {
  id                 String           @id @default(uuid()) @db.Uuid
  ownerId            String
  kind               NotificationKind
  title              String
  body               String           @db.Text
  /// In-app destination, e.g. /dsa-questions/lru-cache.
  href               String?
  /// What produced this — a HelpRequest id today. Paired with kind it makes a
  /// repeat delivery a no-op instead of a second identical row in the inbox.
  subjectId          String?
  readAt             DateTime?
  /// Non-null only when this event is urgent enough for email and email was
  /// configured when it was recorded. The remaining fields form a durable,
  /// leased retry state machine; they never affect the in-app record.
  emailRequestedAt   DateTime?
  emailAttempts      Int              @default(0)
  emailLeaseToken    String?
  emailLeaseUntil    DateTime?
  emailNextAttemptAt DateTime?
  emailSentAt        DateTime?
  emailFailedAt      DateTime?
  emailLastError     String?          @db.Text
  /// Optional channel-specific copy persisted so retries send the same email.
  emailSubject       String?
  emailBody          String?          @db.Text
  /// Materialized HTML and sender label keep retries identical across deploys.
  emailHtml          String?          @db.Text
  emailFromName      String?
  createdAt          DateTime         @default(now())
  owner              CandidateProfile @relation("CandidateNotifications", fields: [ownerId], references: [ownerId], onDelete: Cascade)

  @@unique([ownerId, kind, subjectId])
  @@index([ownerId, readAt])
  @@index([ownerId, createdAt])
}

/// Why somebody flagged a help interaction.
enum HelpReportReason {
  HARASSMENT
  SPAM
  OFF_TOPIC
  /// The helper handed over the answer instead of explaining it.
  SOLUTION_DUMPING
  OTHER
}

/// One person never wanting to be paired with another again.
///
/// Stored one-directional but always enforced both ways: the person who blocked
/// should not see the other, and the other must not be able to work out that
/// they were blocked by noticing they can still see the first. Symmetry removes
/// that oracle.
model HelpBlock {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String
  blockedId String
  createdAt DateTime @default(now())

  @@unique([ownerId, blockedId])
  @@index([blockedId])
}

/// A flagged interaction, queued for a human to look at.
///
/// Deliberately not actioned automatically. An automated ban built on a report
/// count is a weapon anybody can point at anybody; at this size a person can
/// read every one of these.
model HelpReport {
  id         String           @id @default(uuid()) @db.Uuid
  requestId  String           @db.Uuid
  reporterId String
  reportedId String
  reason     HelpReportReason
  detail     String?          @db.Text
  createdAt  DateTime         @default(now())
  /// Set when an operator has looked at it. Null means it is still waiting.
  reviewedAt DateTime?

  @@unique([requestId, reporterId])
  @@index([reportedId])
  @@index([reviewedAt, createdAt])
  @@index([requestId])
}

model CandidatePerformanceProfileVersion {
  id                       String           @id @default(uuid()) @db.Uuid
  ownerId                  String
  revision                 Int
  schemaVersion            Int
  sourceSessionFingerprint String
  completedSessionCount    Int
  answeredQuestionCount    Int
  profile                  Json
  generatedAt              DateTime
  createdAt                DateTime         @default(now())
  owner                    CandidateProfile @relation("CandidatePerformanceProfileVersions", fields: [ownerId], references: [ownerId], onDelete: Cascade)

  @@unique([ownerId, revision])
  @@unique([ownerId, sourceSessionFingerprint, schemaVersion])
  @@index([ownerId, generatedAt])
  @@index([sourceSessionFingerprint])
}

/// Immutable aggregate of server-verified Practice attempts. Interview-plan
/// revisions may read this evidence; historical attempts and plans never move.
model CandidatePracticeEvidenceVersion {
  id                       String           @id @default(uuid()) @db.Uuid
  ownerId                  String
  revision                 Int
  schemaVersion            Int
  sourceAttemptFingerprint String
  verifiedAttemptCount     Int
  verifiedQuestionCount    Int
  evidence                 Json
  generatedAt              DateTime
  createdAt                DateTime         @default(now())
  owner                    CandidateProfile @relation("CandidatePracticeEvidenceVersions", fields: [ownerId], references: [ownerId], onDelete: Cascade)

  @@unique([ownerId, revision])
  @@unique([ownerId, sourceAttemptFingerprint, schemaVersion])
  @@index([ownerId, generatedAt])
  @@index([sourceAttemptFingerprint])
}

/// Immutable normalized resume/profile snapshot. A new source resume creates
/// a new revision; historical interview plans keep pointing at the old one.
model CandidateInterviewProfileVersion {
  id                      String                             @id @default(uuid()) @db.Uuid
  ownerId                 String
  revision                Int
  schemaVersion           Int
  sourceResumeFingerprint String
  profile                 Json
  generatedAt             DateTime
  createdAt               DateTime                           @default(now())
  owner                   CandidateProfile                   @relation("CandidateInterviewProfileVersions", fields: [ownerId], references: [ownerId], onDelete: Cascade)
  plans                   PersonalizedInterviewPlanVersion[]

  @@unique([ownerId, revision])
  @@unique([ownerId, sourceResumeFingerprint, schemaVersion])
  @@index([ownerId, generatedAt])
  @@index([sourceResumeFingerprint])
}

/// Versioned five-session plan. READY is the active revision; saving a newer
/// READY plan supersedes the previous one without changing historical data.
model PersonalizedInterviewPlanVersion {
  id                String                           @id @default(uuid()) @db.Uuid
  ownerId           String
  profileVersionId  String                           @db.Uuid
  revision          Int
  schemaVersion     Int
  status            PersonalizedInterviewPlanStatus  @default(DRAFT)
  sourceSnapshot    Json
  rationale         String                           @db.Text
  generatedAt       DateTime
  supersededAt      DateTime?
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt
  owner             CandidateProfile                 @relation("CandidateInterviewPlanVersions", fields: [ownerId], references: [ownerId], onDelete: Cascade)
  profileVersion    CandidateInterviewProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Restrict)
  sessionBlueprints InterviewSessionBlueprint[]

  @@unique([ownerId, revision])
  @@index([ownerId, status])
  @@index([profileVersionId])
  @@index([generatedAt])
}

/// Queryable session metadata plus the complete immutable blueprint snapshot.
model InterviewSessionBlueprint {
  id              String                           @id @default(uuid()) @db.Uuid
  planVersionId   String                           @db.Uuid
  kind            PersonalizedInterviewSessionKind
  order           Int
  title           String
  subtitle        String
  durationMinutes Int
  difficulty      String
  blueprint       Json
  createdAt       DateTime                         @default(now())
  planVersion     PersonalizedInterviewPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, kind])
  @@unique([planVersionId, order])
  @@index([planVersionId])
  @@index([kind])
}

model DsaPhase {
  slug          String        @id
  title         String
  phaseNumber   Int
  questionCount Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  questions     DsaQuestion[]

  @@index([phaseNumber])
}

model DsaQuestion {
  slug                 String                    @id
  /// Incremented only when authored content changes in a way that should be
  /// snapshotted or re-reviewed by downstream practice consumers.
  contentVersion       Int                       @default(1)
  phaseSlug            String
  title                String
  source               String
  externalUrl          String
  primaryPattern       String
  subPatterns          String[]
  difficulty           String
  expectedTimeMinutes  Int
  recommendedOrder     Int
  prerequisites        String[]
  conceptsTested       String[]
  commonMistakes       String[]
  interviewSignals     String[]
  followUpPrompts      String[]
  promptSummary        String                    @db.Text
  highLevelApproach    String                    @db.Text
  complexity           Json
  problemStatement     String?                   @db.Text
  constraints          String[]
  examples             Json?
  keyInsight           String?                   @db.Text
  hints                String[]
  approaches           Json?
  edgeCases            String[]
  relatedQuestions     String[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  phase                DsaPhase                  @relation(fields: [phaseSlug], references: [slug], onDelete: Cascade)
  roadmapQuestions     RoadmapQuestionTemplate[]
  userQuestionProgress UserQuestionProgress[]
  userQuestionAttempts UserQuestionAttempt[]
  userNotes            UserDsaQuestionNote[]

  helpRequests HelpRequest[]

  @@unique([phaseSlug, recommendedOrder])
  @@index([phaseSlug])
  @@index([primaryPattern])
  @@index([difficulty])
  @@index([recommendedOrder])
}

model UserDsaQuestionNote {
  id        String           @id @default(uuid()) @db.Uuid
  ownerId   String
  slug      String
  content   String           @db.Text
  /// Editable normalized pen strokes for this question's drawing canvas.
  drawing   Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  owner     CandidateProfile @relation(fields: [ownerId], references: [ownerId], onDelete: Cascade)
  question  DsaQuestion      @relation(fields: [slug], references: [slug], onDelete: Cascade)

  @@unique([ownerId, slug])
  @@index([ownerId])
  @@index([slug])
}

model PrepQuestionTemplate {
  id                   String                        @id
  contentVersion       Int                           @default(1)
  bank                 String
  sessionKey           String
  chapterKey           String
  category             String
  title                String
  roles                String[]
  levels               String[]
  difficulty           String
  expectedMinutes      Int
  evidenceType         String
  competency           String
  format               String                        @default("typed")
  prompt               String                        @db.Text
  promptTemplate       String?                       @db.Text
  objective            String                        @db.Text
  prerequisites        String[]                      @default([])
  hints                String[]                      @default([])
  explanation          String                        @db.Text
  answerKey            Json?
  publicationStatus    PrepQuestionPublicationStatus @default(DRAFT)
  tags                 String[]
  whatItTests          String[]
  goodAnswerSignals    String[]
  weakAnswerSignals    String[]
  followUpPrompts      String[]
  mayaPushbacks        String[]
  answerStructure      Json
  scoringRubric        Json
  sourceLinks          Json
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  roadmapQuestions     RoadmapQuestionTemplate[]
  userQuestionProgress UserQuestionProgress[]
  userQuestionAttempts UserQuestionAttempt[]
  userNotes            UserPrepQuestionNote[]

  @@index([bank])
  @@index([sessionKey, publicationStatus])
  @@index([chapterKey])
  @@index([category])
  @@index([competency])
  @@index([difficulty])
}

model RoadmapTemplate {
  id           String                   @id @default(uuid()) @db.Uuid
  role         String
  slug         String                   @unique
  title        String
  description  String?                  @db.Text
  version      Int                      @default(1)
  status       RoadmapTemplateStatus    @default(ACTIVE)
  metadata     Json?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  sessions     RoadmapSessionTemplate[]
  userRoadmaps UserRoadmap[]

  @@unique([role, version])
  @@index([role])
  @@index([status])
}

model RoadmapSessionTemplate {
  id         String                    @id @default(uuid()) @db.Uuid
  templateId String                    @db.Uuid
  slug       String
  order      Int
  title      String
  purpose    String                    @db.Text
  covers     String[]
  metadata   Json?
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  template   RoadmapTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  chapters   RoadmapChapterTemplate[]
  questions  RoadmapQuestionTemplate[]
  progress   UserSessionProgress[]

  @@unique([templateId, slug])
  @@unique([templateId, order])
  @@index([templateId])
}

model RoadmapChapterTemplate {
  id                String                    @id @default(uuid()) @db.Uuid
  sessionTemplateId String                    @db.Uuid
  slug              String
  order             Int
  title             String
  purpose           String?                   @db.Text
  metadata          Json?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  sessionTemplate   RoadmapSessionTemplate    @relation(fields: [sessionTemplateId], references: [id], onDelete: Cascade)
  questions         RoadmapQuestionTemplate[]
  progress          UserChapterProgress[]

  @@unique([sessionTemplateId, slug])
  @@unique([sessionTemplateId, order])
  @@index([sessionTemplateId])
}

model RoadmapQuestionTemplate {
  id                     String                    @id @default(uuid()) @db.Uuid
  sessionTemplateId      String                    @db.Uuid
  chapterTemplateId      String?                   @db.Uuid
  order                  Int
  sourceType             RoadmapQuestionSourceType
  dsaQuestionSlug        String?
  prepQuestionTemplateId String?
  titleSnapshot          String
  difficulty             String?
  expectedMinutes        Int?
  metadata               Json?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  sessionTemplate        RoadmapSessionTemplate    @relation(fields: [sessionTemplateId], references: [id], onDelete: Cascade)
  chapterTemplate        RoadmapChapterTemplate?   @relation(fields: [chapterTemplateId], references: [id], onDelete: Cascade)
  dsaQuestion            DsaQuestion?              @relation(fields: [dsaQuestionSlug], references: [slug], onDelete: SetNull)
  prepQuestionTemplate   PrepQuestionTemplate?     @relation(fields: [prepQuestionTemplateId], references: [id], onDelete: SetNull)
  userQuestionProgress   UserQuestionProgress[]

  @@unique([sessionTemplateId, order])
  @@unique([sessionTemplateId, prepQuestionTemplateId])
  @@index([sessionTemplateId])
  @@index([chapterTemplateId])
  @@index([sourceType])
  @@index([dsaQuestionSlug])
  @@index([prepQuestionTemplateId])
}

model UserRoadmap {
  id                          String                      @id @default(uuid()) @db.Uuid
  ownerId                     String
  templateId                  String?                     @db.Uuid
  role                        String
  status                      UserRoadmapStatus           @default(ACTIVE)
  title                       String
  templateVersion             Int?
  currentSessionTemplateSlug  String?
  currentChapterTemplateSlug  String?
  nextQuestionKey             String?
  totalSessions               Int                         @default(0)
  completedSessions           Int                         @default(0)
  totalQuestions              Int                         @default(0)
  attemptedQuestions          Int                         @default(0)
  completedQuestions          Int                         @default(0)
  estimatedMinutesRemaining   Int?
  overallProgressPercent      Float                       @default(0)
  personalization             Json?
  stats                       Json?
  sourceInterviewPlanId       String?                     @db.Uuid
  sourceInterviewPlanRevision Int?
  sourceProfileVersionId      String?                     @db.Uuid
  sourceProfileRevision       Int?
  practiceGenerationVersion   Int                         @default(1)
  generatedAt                 DateTime                    @default(now())
  recalculatedAt              DateTime?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  owner                       CandidateProfile            @relation(fields: [ownerId], references: [ownerId], onDelete: Cascade)
  template                    RoadmapTemplate?            @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sessionProgress             UserSessionProgress[]
  chapterProgress             UserChapterProgress[]
  questionProgress            UserQuestionProgress[]
  insights                    UserMayaInsight[]
  practiceQuestionPlacements  PracticeQuestionPlacement[]

  @@unique([ownerId, role])
  @@index([ownerId])
  @@index([templateId])
  @@index([role])
  @@index([status])
}

model UserSessionProgress {
  id                      String                      @id @default(uuid()) @db.Uuid
  roadmapId               String                      @db.Uuid
  sessionTemplateId       String                      @db.Uuid
  status                  RoadmapProgressStatus       @default(LOCKED)
  order                   Int
  startedAt               DateTime?
  completedAt             DateTime?
  totalQuestions          Int                         @default(0)
  attemptedQuestions      Int                         @default(0)
  completedQuestions      Int                         @default(0)
  progressPercent         Float                       @default(0)
  practiceSessionKey      String
  availability            PracticeSessionAvailability @default(UNAVAILABLE)
  titleSnapshot           String?
  purposeSnapshot         String?                     @db.Text
  coversSnapshot          String[]                    @default([])
  difficultySnapshot      String?
  durationMinutesSnapshot Int?
  sourceBlueprintId       String?                     @db.Uuid
  sourceBlueprintKind     String?
  personalizedAt          DateTime?
  metadata                Json?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  roadmap                 UserRoadmap                 @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  sessionTemplate         RoadmapSessionTemplate      @relation(fields: [sessionTemplateId], references: [id], onDelete: Cascade)
  chapters                UserChapterProgress[]
  questions               UserQuestionProgress[]
  practicePlacements      PracticeQuestionPlacement[]

  @@unique([roadmapId, sessionTemplateId])
  @@unique([roadmapId, practiceSessionKey])
  @@index([roadmapId])
  @@index([sessionTemplateId])
  @@index([status])
}

model UserChapterProgress {
  id                 String                 @id @default(uuid()) @db.Uuid
  roadmapId          String                 @db.Uuid
  sessionProgressId  String                 @db.Uuid
  chapterTemplateId  String                 @db.Uuid
  status             RoadmapProgressStatus  @default(LOCKED)
  order              Int
  startedAt          DateTime?
  completedAt        DateTime?
  totalQuestions     Int                    @default(0)
  attemptedQuestions Int                    @default(0)
  completedQuestions Int                    @default(0)
  progressPercent    Float                  @default(0)
  metadata           Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  roadmap            UserRoadmap            @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  sessionProgress    UserSessionProgress    @relation(fields: [sessionProgressId], references: [id], onDelete: Cascade)
  chapterTemplate    RoadmapChapterTemplate @relation(fields: [chapterTemplateId], references: [id], onDelete: Cascade)
  questions          UserQuestionProgress[]

  @@unique([roadmapId, chapterTemplateId])
  @@index([roadmapId])
  @@index([sessionProgressId])
  @@index([chapterTemplateId])
  @@index([status])
}

model UserQuestionProgress {
  id                        String                      @id @default(uuid()) @db.Uuid
  roadmapId                 String                      @db.Uuid
  sessionProgressId         String                      @db.Uuid
  chapterProgressId         String?                     @db.Uuid
  roadmapQuestionTemplateId String?                     @db.Uuid
  sourceType                RoadmapQuestionSourceType
  dsaQuestionSlug           String?
  prepQuestionTemplateId    String?
  status                    RoadmapProgressStatus       @default(LOCKED)
  order                     Int
  attemptCount              Int                         @default(0)
  bestScore                 Float?
  lastAttemptedAt           DateTime?
  completedAt               DateTime?
  draftAnswer               String?                     @db.Text
  draftUpdatedAt            DateTime?
  revealedHintCount         Int                         @default(0)
  metadata                  Json?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  roadmap                   UserRoadmap                 @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  sessionProgress           UserSessionProgress         @relation(fields: [sessionProgressId], references: [id], onDelete: Cascade)
  chapterProgress           UserChapterProgress?        @relation(fields: [chapterProgressId], references: [id], onDelete: SetNull)
  roadmapQuestionTemplate   RoadmapQuestionTemplate?    @relation(fields: [roadmapQuestionTemplateId], references: [id], onDelete: SetNull)
  dsaQuestion               DsaQuestion?                @relation(fields: [dsaQuestionSlug], references: [slug], onDelete: SetNull)
  prepQuestionTemplate      PrepQuestionTemplate?       @relation(fields: [prepQuestionTemplateId], references: [id], onDelete: SetNull)
  attempts                  UserQuestionAttempt[]
  practicePlacements        PracticeQuestionPlacement[]

  @@unique([roadmapId, order])
  @@unique([roadmapId, prepQuestionTemplateId])
  @@index([roadmapId])
  @@index([sessionProgressId])
  @@index([chapterProgressId])
  @@index([roadmapQuestionTemplateId])
  @@index([sourceType])
  @@index([status])
  @@index([dsaQuestionSlug])
  @@index([prepQuestionTemplateId])
}

model UserPrepQuestionNote {
  id                     String               @id @default(uuid()) @db.Uuid
  ownerId                String
  prepQuestionTemplateId String
  content                String               @db.Text
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  owner                  CandidateProfile     @relation(fields: [ownerId], references: [ownerId], onDelete: Cascade)
  question               PrepQuestionTemplate @relation(fields: [prepQuestionTemplateId], references: [id], onDelete: Cascade)

  @@unique([ownerId, prepQuestionTemplateId])
  @@index([ownerId])
  @@index([prepQuestionTemplateId])
}

/// Candidate-specific placement of one canonical progress record into a
/// Practice session. Final Mock can point at progress owned by an earlier
/// session, so mixed review never duplicates mastery or attempt history.
model PracticeQuestionPlacement {
  id                          String               @id @default(uuid()) @db.Uuid
  roadmapId                   String               @db.Uuid
  sessionProgressId           String               @db.Uuid
  questionProgressId          String               @db.Uuid
  practiceSessionKey          String
  order                       Int
  selectionReason             String
  contentVersion              Int
  sourceInterviewPlanId       String?              @db.Uuid
  sourceInterviewPlanRevision Int?
  sourceProfileVersionId      String?              @db.Uuid
  sourceProfileRevision       Int?
  metadata                    Json?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  roadmap                     UserRoadmap          @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  sessionProgress             UserSessionProgress  @relation(fields: [sessionProgressId], references: [id], onDelete: Cascade)
  questionProgress            UserQuestionProgress @relation(fields: [questionProgressId], references: [id], onDelete: Cascade)

  @@unique([sessionProgressId, order])
  @@unique([sessionProgressId, questionProgressId])
  @@index([roadmapId, practiceSessionKey])
  @@index([questionProgressId])
  @@index([sourceInterviewPlanId])
}

model UserQuestionAttempt {
  id                     String                             @id @default(uuid()) @db.Uuid
  ownerId                String
  /// Client-generated request identity. Null preserves legacy rows; new
  /// practice writes use it so retries cannot create a second attempt event.
  idempotencyKey         String?                            @db.Uuid
  questionProgressId     String                             @db.Uuid
  sourceType             RoadmapQuestionSourceType
  dsaQuestionSlug        String?
  prepQuestionTemplateId String?
  status                 RoadmapQuestionAttemptStatus       @default(STARTED)
  /// Canonical editor language (javascript, python, cpp, java) when this
  /// attempt came from the code runner. Null for non-code/manual attempts.
  language               String?
  answer                 String?                            @db.Text
  score                  Float?
  correctness            String?
  /// Authored question/rubric revision evaluated for this immutable attempt.
  questionContentVersion Int?
  /// Versioned evaluator contract, independent of the provider/model name.
  evaluatorVersion       String?
  verificationStatus     PracticeAttemptVerificationStatus?
  durationMs             Int?
  feedback               Json?
  createdAt              DateTime                           @default(now())
  updatedAt              DateTime                           @updatedAt
  owner                  CandidateProfile                   @relation(fields: [ownerId], references: [ownerId], onDelete: Cascade)
  questionProgress       UserQuestionProgress               @relation(fields: [questionProgressId], references: [id], onDelete: Cascade)
  dsaQuestion            DsaQuestion?                       @relation(fields: [dsaQuestionSlug], references: [slug], onDelete: SetNull)
  prepQuestionTemplate   PrepQuestionTemplate?              @relation(fields: [prepQuestionTemplateId], references: [id], onDelete: SetNull)

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, createdAt])
  @@index([questionProgressId])
  @@index([sourceType])
  @@index([status])
  @@index([dsaQuestionSlug])
  @@index([ownerId, dsaQuestionSlug, status, score])
  @@index([dsaQuestionSlug, language, status, score])
  @@index([prepQuestionTemplateId])
  @@index([sourceType, verificationStatus, createdAt])
}

model UserMayaInsight {
  id            String           @id @default(uuid()) @db.Uuid
  roadmapId     String           @db.Uuid
  ownerId       String
  kind          MayaInsightKind
  title         String
  body          String           @db.Text
  evidenceLabel String?
  ctaLabel      String?
  ctaHref       String?
  priority      Int              @default(0)
  isActive      Boolean          @default(true)
  source        Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  roadmap       UserRoadmap      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  owner         CandidateProfile @relation(fields: [ownerId], references: [ownerId], onDelete: Cascade)

  @@index([roadmapId])
  @@index([ownerId, isActive])
  @@index([kind])
  @@index([priority])
}
