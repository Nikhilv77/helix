NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_system_design?schema=public
APP_NAME=Trailgrad
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost:5173
# Absolute origin this app is served from. Feeds metadataBase, canonical
# URLs, robots.txt and sitemap.xml. Production must be https://trailgrad.com;
# the code falls back to that when this is unset.
NEXT_PUBLIC_APP_URL=http://localhost:3001
LOG_LEVEL=info
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-your-clerk-publishable-key
CLERK_SECRET_KEY=replace-with-your-clerk-secret-key
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_FAST_MODEL=gemini-flash-lite-latest
GEMINI_REASONING_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_MODEL_VERSION=v1
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
KNOWLEDGE_CHUNK_MAX_TOKENS=800
KNOWLEDGE_EMBEDDING_DIMENSIONS=768
KNOWLEDGE_EMBEDDING_BATCH_SIZE=16
RETRIEVAL_DEFAULT_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.2

# LiveKit (voice)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=helix-interviewer-v2

# Groq — used for the per-turn interview decision (latency path).
# Falls back to Gemini when unset.
GROQ_API_KEY=
GROQ_DECIDER_MODEL=openai/gpt-oss-20b

# Interviewer avatar for the voice screen: any .glb with ARKit blendshapes
# and Oculus visemes. Create one at avaturn.me, or drop a file in
# public/avatars and use a relative path. Falls back to the contour figure
# when unset.
#   NEXT_PUBLIC_AVATAR_URL=/avatars/interviewer-v2.glb
NEXT_PUBLIC_AVATAR_URL=

# Sessions per user per day. Product cap is 2; raise locally for development.
INTERVIEW_DAILY_LIMIT=2

# Voice for Maya outside the interview room (workspace welcome).
# Reuse the DEEPGRAM_API_KEY from agent/.env.local so both sound identical.
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-asteria-en
