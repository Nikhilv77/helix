NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_system_design?schema=public
APP_NAME=Trailgrad
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost:5173
# Absolute origin this app is served from. Feeds metadataBase, canonical
# URLs, robots.txt and sitemap.xml. Production must be https://trailgrad.com;
# the code falls back to that when this is unset.
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Google Search Console HTML meta verification token. Paste only the content
# value, not the full meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
LOG_LEVEL=info
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-your-clerk-publishable-key
CLERK_SECRET_KEY=replace-with-your-clerk-secret-key
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_FAST_MODEL=gemini-flash-lite-latest
GEMINI_REASONING_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_MODEL_VERSION=v1
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
KNOWLEDGE_CHUNK_MAX_TOKENS=800
KNOWLEDGE_EMBEDDING_DIMENSIONS=768
KNOWLEDGE_EMBEDDING_BATCH_SIZE=16
RETRIEVAL_DEFAULT_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.2

# Clerk user ids allowed to read /help/reports, comma-separated. Empty means
# nobody — the moderation queue is closed until somebody is named here.
OPERATOR_USER_IDS=

# Contextual peer help. Milestone A routes every "Ask someone" request here —
# a Slack or Discord incoming webhook — because there is no helper pool yet and
# no notification layer. Leave unset to record requests and log them only.

# Notifications stay in-app unless this launch switch is explicitly enabled.
# The Resend implementation and delivery history may remain configured dormant

# LiveKit (voice)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=helix-interviewer-v2

# Groq — used for the per-turn interview decision (latency path).
# Falls back to Gemini when unset.
GROQ_API_KEY=
GROQ_DECIDER_MODEL=openai/gpt-oss-20b

# Interviewer avatar override. Leave empty: each interview picks a persona from
# src/lib/avatars/personas.ts, keyed by session id. Set a path to pin one model
# everywhere while previewing a replacement, or "off" for the contour figure.
#   NEXT_PUBLIC_AVATAR_URL=/avatars/claire.glb
NEXT_PUBLIC_AVATAR_URL=

# Sessions per user per day. Product cap is 2; raise locally for development.
INTERVIEW_DAILY_LIMIT=2
# Random secret used only for signed anonymous interview cookies and the
# session-scoped voice-worker capability. Generate at least 32 random bytes.
INTERVIEW_AUTH_SECRET=

# Shared abuse protection and distributed per-session locks. Create a small
# Upstash Redis database and copy its REST credentials here. Development and
# tests use a process-local fallback; protected production routes fail closed
# when these values are missing or Redis cannot be reached.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Voice for Maya outside the interview room (workspace welcome).
# Reuse the DEEPGRAM_API_KEY from agent/.env.local so both sound identical.
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-asteria-en

# Judge0 CE through RapidAPI. Keep the key server-side only.
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
RAPIDAPI_KEY=
RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

UPSTASH_REDIS_REST_URL="https://....."
UPSTASH_REDIS_REST_TOKEN="aaaa.........."

# Resend email notifs
NOTIFICATION_EMAIL_ENABLED=true
RESEND_API_KEY=re_...
NOTIFICATION_FROM_EMAIL="Trailgrad <hello@trailgrad.com>"
CRON_SECRET=replace-with-a-long-random-secret
