NODE_ENV=development
PORT=3000
# Local development database only. For Neon, paste the pooled connection URL
# from a separate development project/branch. Never paste the production URL.
DATABASE_URL=postgresql://USER:PASSWORD@DEV-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Recommended for Prisma migrations, Studio, and administrative commands.
# Copy the connection string for the same dev database with pooling disabled.
DIRECT_URL=postgresql://USER:PASSWORD@DEV-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require
APP_NAME=Trailgrad
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost:5173
# Absolute origin this app is served from. Feeds metadataBase, canonical
# URLs, robots.txt and sitemap.xml. Production must be https://trailgrad.com;
# the code falls back to that when this is unset.
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Google Search Console HTML meta verification token. Paste only the content
# value, not the full meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
LOG_LEVEL=info
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-your-clerk-publishable-key
CLERK_SECRET_KEY=replace-with-your-clerk-secret-key
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_FAST_MODEL=gemini-flash-lite-latest
GEMINI_REASONING_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_MODEL_VERSION=v1
# Native-audio interviewer for resume and behavioral sessions only. This is a
# kill switch while Gemini Live remains preview; no browser receives the API key.
GEMINI_LIVE_INTERVIEWS_ENABLED=true
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Dedicated candidate speech recognition. It runs beside the native-audio
# interviewer in bilingual English/Hindi Verbatim mode with resume vocabulary
# biasing, so the transcript preserves intent instead of rewriting the answer.
GEMINI_LIVE_TRANSCRIPTION_MODEL=gemini-3.5-transcribe-live
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
KNOWLEDGE_CHUNK_MAX_TOKENS=800
KNOWLEDGE_EMBEDDING_DIMENSIONS=768
KNOWLEDGE_EMBEDDING_BATCH_SIZE=16
RETRIEVAL_DEFAULT_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.2

# Clerk user ids allowed to read /help/reports, comma-separated. Empty means
# nobody — the moderation queue is closed until somebody is named here.
OPERATOR_USER_IDS=

# The one raw Clerk user id allowed to open /operations/interviews and its API.
# Unlike OPERATOR_USER_IDS, this is intentionally a singleton and has no local bypass.
INTERVIEW_OPERATIONS_ADMIN_USER_ID=

# LiveKit (peer-help calls only)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Groq — used for the per-turn interview decision (latency path).
# Falls back to Gemini when unset.
GROQ_API_KEY=
GROQ_DECIDER_MODEL=openai/gpt-oss-20b

# Interviewer avatar override. Leave empty: each interview picks a persona from
# src/lib/avatars/personas.ts, keyed by session id. Set a path to pin one model
# everywhere while previewing a replacement, or "off" for the contour figure.
#   NEXT_PUBLIC_AVATAR_URL=/avatars/claire.glb
NEXT_PUBLIC_AVATAR_URL=

# Sessions per user per day. Product cap is 2; raise locally for development.
INTERVIEW_DAILY_LIMIT=2
# Candidate-data retention. The daily maintenance job permanently deletes the
# entire interview session (transcript, report and child operational rows) once
# it is older than the applicable last-activity cutoff.
INTERVIEW_AUTHENTICATED_RETENTION_DAYS=365
INTERVIEW_ANONYMOUS_RETENTION_DAYS=30
# Terminal request/recovery rows can be removed sooner. PENDING and PROCESSING
# evaluation jobs belonging to retained sessions are always preserved. When a
# parent session reaches its own retention cutoff, its child rows cascade away.
INTERVIEW_OPERATIONAL_RETENTION_DAYS=30
# Bounds each maintenance transaction and the aggregate dashboard read.
INTERVIEW_RETENTION_BATCH_SIZE=250
INTERVIEW_METRICS_SAMPLE_LIMIT=5000
# Random secret used only for signed anonymous interview cookies and the
# session-scoped voice-worker capability. Generate at least 32 random bytes.
# INTERVIEW_AUTH_SECRET=replace-with-at-least-32-random-bytes

# Shared abuse protection and distributed per-session locks. Create a small
# Upstash Redis database and copy its REST credentials here. Development and
# tests use a process-local fallback; protected production routes fail closed
# when these values are missing or Redis cannot be reached.
# UPSTASH_REDIS_REST_URL=https://replace-with-your-upstash-host
# UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-token

# Voice for scripted workspace audio outside Gemini Live interviews.
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-asteria-en

# Judge0 CE through RapidAPI. Keep the key server-side only.
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
RAPIDAPI_KEY=
RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# Notifications stay in-app unless this switch is explicitly enabled. When
# enabled, all three Resend/from/origin values are required.
NOTIFICATION_EMAIL_ENABLED=false
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL="Trailgrad <hello@trailgrad.com>"
CRON_SECRET=replace-with-a-long-random-secret
