# Copy to .env.local. This file is for the Python agent only; the Next.js app
# reads the repo-root .env.

# LiveKit Cloud — the same project the Next.js token endpoint uses.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech. One key covers both STT (nova-3) and TTS (aura-2).
DEEPGRAM_API_KEY=

# Where the interview brain lives.
HELIX_API_BASE_URL=http://localhost:3001

# Optional provider overrides — see config.py.
# HELIX_STT_MODEL=nova-3
# HELIX_TTS_MODEL=aura-2-odysseus-en
# HELIX_ENDPOINTING_MS=300
