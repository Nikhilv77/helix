{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.backend.json"
      }
    ]
  },
  "setupFiles": ["<rootDir>/test/jest.setup.ts"],
  "testEnvironment": "node",
  "maxWorkers": 1
}
