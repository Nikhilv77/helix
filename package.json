{
  "name": "helix",
  "version": "0.1.0",
  "description": "Helix system design workspace.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "prisma generate && next build",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "test": "vitest run && jest --runInBand",
    "test:watch": "vitest",
    "backend:start": "node dist/main.js",
    "backend:dev": "nest start --watch",
    "backend:build": "nest build",
    "backend:test": "jest",
    "backend:test:watch": "jest --watch",
    "backend:test:cov": "jest --coverage",
    "backend:test:e2e": "jest --config ./test/jest-e2e.json",
    "format": "prettier --write \"{src,backend/src,test,prisma}/**/*.{ts,tsx,js,json,md,prisma}\" \"*.{json,md,yml}\"",
    "ai:verify": "ts-node -r tsconfig-paths/register backend/src/ai/dev/verify-structured-output.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@clerk/backend": "^3.14.0",
    "@clerk/nextjs": "^7.6.3",
    "@google/genai": "^2.13.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "lucide-react": "^1.27.0",
    "mermaid": "^11.16.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.2",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.23",
    "prettier": "^3.4.2",
    "prisma": "^6.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
