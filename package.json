{
  "name": "trailgrad",
  "version": "0.1.0",
  "description": "Trailgrad system design workspace.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "prisma generate && next build",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "test": "vitest run && jest --runInBand",
    "test:watch": "vitest",
    "test:server": "jest --runInBand",
    "format": "prettier --write \"{src,test,prisma}/**/*.{ts,tsx,js,json,md,prisma}\" \"*.{json,md,yml}\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "agent:dev": "cd agent && .venv/bin/python main.py dev",
    "agent:start": "cd agent && python main.py start",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@clerk/backend": "^3.14.0",
    "@clerk/nextjs": "^7.6.3",
    "@google/genai": "^2.13.0",
    "@prisma/client": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.4.7",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "lucide-react": "^1.27.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.0",
    "next": "^16.2.12",
    "pdf-parse": "2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "three": "^0.185.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.23",
    "prettier": "^3.4.2",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
